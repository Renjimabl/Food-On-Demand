# Settings for the Food On Demand (manager) APK tests

# Which APK to install. QA build is the safe default for testing.
APK_PATH=path\to\your.apk
# APK_PATH=path\to\your.apk

# Filled in automatically by find_app.py (after the APK is installed)
APP_PACKAGE=com.softland.foodondemand
APP_ACTIVITY=com.softland.foodondemand.Activities.FodSplashPortraitActivity

# Login used for the APK tests (Outlet Manager created in the admin portal)
APK_USERNAME=CHANGE_ME
APK_PASSWORD=CHANGE_ME

# Android SDK location (adb lives in platform-tools inside this folder)
ANDROID_HOME=C:\path\to\Android\Sdk


# 4-digit Customer ID the app asks for before the login screen (fill in)
APK_CUSTOMER_ID=CHANGE_ME

