# Settings for the Kitchen Staff APK tests (KitchenStaff_QA_v2.0.0)
APK_PATH=path\to\your.apk
APP_PACKAGE=com.softland.fod_kitchen_staff
APP_ACTIVITY=

# Customer ID asked on first start (leave as is if the app does not ask)
KITCHEN_CUSTOMER_ID=CHANGE_ME

# Kitchen Staff account created in the admin portal (role Kitchen Staff)
KITCHEN_USERNAME=CHANGE_ME
KITCHEN_PASSWORD=CHANGE_ME

# A manager account - must NOT be able to sign in on the kitchen app
MANAGER_USERNAME=CHANGE_ME
MANAGER_PASSWORD=CHANGE_ME
